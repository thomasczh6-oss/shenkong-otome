; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but it is still readable by humans.

config_version=5

[application]

config/name="深与空恋"
config/version="0.8.0"
config/debug_menu=true
config/description="面向女性玩家的移动端乙女恋爱游戏原型（Godot 4.4）"
run/main_scene="res://src/App.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
config/icon="res://icon.png"

[autoload]

Data="*res://src/autoload/Data.gd"
Game="*res://src/autoload/Game.gd"
UIKit="*res://src/autoload/UIKit.gd"
Router="*res://src/autoload/Router.gd"
ImageGen="*res://src/autoload/ImageGen.gd"
Audio="*res://src/autoload/Audio.gd"

[display]

window/size/viewport_width=1080
window/size/viewport_height=1920
window/size/window_width_override=450
window/size/window_height_override=800
window/stretch/mode="canvas_items"
window/stretch/aspect="keep_width"
window/handheld/orientation=1

[input_devices]

pointing/emulate_touch_from_mouse=true
pointing/emulate_mouse_from_touch=true

[rendering]

environment/defaults/default_clear_color=Color(0.075, 0.055, 0.165, 1)

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true

[gui]

theme/custom_font="res://assets/fonts/wenkai.ttf"
